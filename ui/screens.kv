#:import FadeTransition kivy.uix.screenmanager.FadeTransition
#:import NoTransition kivy.uix.screenmanager.NoTransition
#:import alpha ui.helpers.alpha
#:import ipath ui.helpers.ipath

<Root>:
    ScreenManager:
        id: sm
        transition: FadeTransition(duration=0.12)
        MainScreen:
            id: main
            name: 'main'
        EditorScreen:
            id: editor
            name: 'editor'
        LessonScreen:
            id: lesson
            name: 'lesson'

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        ScreenManager:
            id: tabs
            transition: NoTransition()
            NotesScreen:
                id: notes
                name: 'notes'
            CalendarScreen:
                id: calendar
                name: 'calendar'
            ScheduleScreen:
                id: schedule
                name: 'schedule'
            MoreScreen:
                id: more
                name: 'more'
        Clip:
            size_hint_y: None
            height: 0 if app.kb_open else dp(68)
            NavBar:
                NavItem:
                    icon: 'notes'
                    text: 'Заметки'
                    active: app.tab == 'notes'
                    on_release: app.open_tab('notes')
                NavItem:
                    icon: 'calendar'
                    text: 'Календарь'
                    active: app.tab == 'calendar'
                    on_release: app.open_tab('calendar')
                NavItem:
                    icon: 'clock'
                    text: 'Расписание'
                    active: app.tab == 'schedule'
                    on_release: app.open_tab('schedule')
                NavItem:
                    icon: 'tune'
                    text: 'Ещё'
                    active: app.tab == 'more'
                    on_release: app.open_tab('more')

<NotesScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            Header:
                Title:
                    text: 'Заметки'
                IconBtn:
                    icon: 'sort'
                    on_release: root.open_sort()
            BoxLayout:
                size_hint_y: None
                height: dp(64)
                padding: dp(16), dp(6), dp(16), dp(6)
                Field:
                    id: search
                    hint: 'Поиск по заметкам'
                    on_text: root.search_changed(self.text)
            ScrollView:
                size_hint_y: None
                height: dp(46)
                do_scroll_y: False
                bar_width: 0
                BoxLayout:
                    id: chips
                    size_hint_x: None
                    width: self.minimum_width
                    spacing: dp(8)
                    padding: dp(16), dp(4), dp(16), dp(4)
            RecycleView:
                id: rv
                viewclass: 'NoteCard'
                bar_width: 0
                RecycleBoxLayout:
                    default_size: None, dp(120)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(12)
                    padding: dp(16), dp(8), dp(16), dp(110)
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            size: dp(300), dp(190)
            pos_hint: {'center_x': .5, 'center_y': .42}
            opacity: 1 if not rv.data else 0
            spacing: dp(8)
            Image:
                source: ipath('notes')
                color: alpha(app.sub, .5)
                size_hint_y: None
                height: dp(64)
                fit_mode: 'contain'
                mipmap: True
            Label:
                text: root.empty_title
                bold: True
                font_size: '17sp'
                size_hint_y: None
                height: dp(32)
            Label:
                text: root.empty_hint
                font_size: '14sp'
                color: app.sub
                halign: 'center'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1] + dp(4)
        AnchorLayout:
            anchor_x: 'right'
            anchor_y: 'bottom'
            padding: dp(20)
            Fab:
                icon: 'edit'
                on_release: app.new_note_sheet()

<CalendarScreen>:
    FloatLayout:
        ScrollView:
            bar_width: 0
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: 0, 0, 0, dp(110)
                Header:
                    Title:
                        text: 'Календарь'
                    Chip:
                        text: 'Сегодня'
                        on_release: root.go_today()
                Pad:
                    padding: dp(16), 0, dp(16), 0
                    Card:
                        size_hint_y: None
                        height: dp(354)
                        bg: app.surface
                        radius: dp(24)
                        padding: dp(4)
                        MonthGrid:
                            id: month
                Section:
                    text: root.heading
                    font_size: '18sp'
                    color: app.fg
                    height: dp(54)
                    padding: dp(22), dp(10), 0, 0
                BoxLayout:
                    id: agenda
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16), 0
                    spacing: dp(10)
        AnchorLayout:
            anchor_x: 'right'
            anchor_y: 'bottom'
            padding: dp(20)
            Fab:
                on_release: root.add_note()

<ScheduleScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            Header:
                Title:
                    text: 'Расписание'
            Label:
                text: root.summary
                font_size: '14sp'
                color: app.sub
                halign: 'left'
                valign: 'top'
                text_size: self.size
                padding: dp(22), 0
                size_hint_y: None
                height: dp(26)
            GridLayout:
                id: days
                cols: 6
                size_hint_y: None
                height: dp(66)
                padding: dp(16), dp(4), dp(16), dp(4)
                spacing: dp(6)
            ScrollView:
                bar_width: 0
                BoxLayout:
                    id: lessons
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16), dp(10), dp(16), dp(110)
                    spacing: dp(10)
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            size: dp(260), dp(150)
            pos_hint: {'center_x': .5, 'center_y': .38}
            opacity: 1 if root.empty else 0
            spacing: dp(8)
            Image:
                source: ipath('clock')
                color: alpha(app.sub, .5)
                size_hint_y: None
                height: dp(64)
                fit_mode: 'contain'
                mipmap: True
            Label:
                text: 'В этот день уроков нет'
                bold: True
                font_size: '17sp'
                size_hint_y: None
                height: dp(28)
            Label:
                text: 'Нажмите «+», чтобы добавить урок'
                font_size: '14sp'
                color: app.sub
                size_hint_y: None
                height: dp(24)
        AnchorLayout:
            anchor_x: 'right'
            anchor_y: 'bottom'
            padding: dp(20)
            Fab:
                on_release: root.add_lesson()

<MoreScreen>:
    ScrollView:
        bar_width: 0
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: dp(16), 0, dp(16), dp(24)
            spacing: dp(8)
            Header:
                padding: dp(6), dp(8), dp(8), dp(8)
                Title:
                    text: 'Ещё'
            Section:
                text: 'ОФОРМЛЕНИЕ'
                padding: dp(6), 0
            Card:
                size_hint_y: None
                height: dp(82)
                bg: app.surface
                radius: dp(22)
                padding: dp(16)
                spacing: dp(10)
                PillBtn:
                    text: 'Светлая'
                    soft: app.dark
                    on_release: app.set_theme('light')
                PillBtn:
                    text: 'Тёмная'
                    soft: not app.dark
                    on_release: app.set_theme('dark')
            Section:
                text: 'ДАННЫЕ'
                padding: dp(6), 0
            Card:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                bg: app.surface
                radius: dp(22)
                padding: dp(16)
                spacing: dp(10)
                Txt:
                    text: root.stats
                    font_size: '15sp'
                    color: app.sub
                PillBtn:
                    text: 'Скопировать резервную копию'
                    soft: True
                    on_release: root.backup()
                PillBtn:
                    text: 'Восстановить из буфера'
                    soft: True
                    on_release: root.restore()
                PillBtn:
                    text: 'Удалить все данные'
                    soft: True
                    fg: app.danger
                    bg: alpha(app.danger, .12)
                    on_release: root.wipe()
            Section:
                text: 'О ПРИЛОЖЕНИИ'
                padding: dp(6), 0
            Card:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                bg: app.surface
                radius: dp(22)
                padding: dp(18)
                spacing: dp(4)
                Txt:
                    text: 'Заметки'
                    bold: True
                    font_size: '17sp'
                Txt:
                    text: 'Версия ' + root.version + '\nЗаметки, календарь и расписание уроков на неделю. Все данные хранятся на устройстве.'
                    font_size: '14sp'
                    color: app.sub
                Txt:
                    text: 'Что нового'
                    bold: True
                    font_size: '15sp'
                Txt:
                    text: root.changes
                    font_size: '13sp'
                    color: app.sub
                Txt:
                    text: app.inset_info
                    font_size: '11sp'
                    color: app.sub

<EditorScreen>:
    canvas.before:
        Color:
            rgba: root.paper
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(8), 0
            IconBtn:
                icon: 'back'
                on_release: root.close()
            Label:
                text: root.stamp_text
                font_size: '12sp'
                color: app.sub
                halign: 'left'
                valign: 'middle'
                text_size: self.size
                shorten: True
                shorten_from: 'right'
                max_lines: 1
                padding: dp(6), 0
            IconBtn:
                icon: 'pin'
                tint: app.accent if root.pinned else app.sub
                on_release: root.toggle_pin()
            IconBtn:
                icon: 'more'
                on_release: root.more()
            DoneBtn:
                on_release: root.done()
        Clip:
            size_hint_y: None
            height: 0 if app.kb_open else dp(46)
            BoxLayout:
                size_hint_y: None
                height: dp(46)
                padding: dp(20), dp(4), dp(20), dp(4)
                spacing: dp(8)
                Chip:
                    text: root.folder_name
                    tone: root.folder_color
                    active: True
                    on_release: root.pick_folder()
                Chip:
                    text: root.date_text
                    active: root.has_date
                    on_release: root.pick_date()
                Widget:
        TextInput:
            id: title
            hint_text: 'Название'
            size_hint_y: None
            height: dp(62)
            multiline: False
            font_size: '25sp'
            padding: dp(20), dp(16), dp(20), dp(12)
            on_text: root.changed()
            on_text_validate: root.focus_body()
        Widget:
            size_hint_y: None
            height: dp(1)
            canvas:
                Color:
                    rgba: app.line_c
                Rectangle:
                    pos: self.x + dp(20), self.y
                    size: self.width - dp(40), self.height
        TextInput:
            id: body
            hint_text: 'Начните писать…'
            font_size: root.fsize
            padding: dp(20), dp(12), dp(20), dp(12)
            size_hint_y: 1 if root.kind == 'text' else 0
            opacity: 1 if root.kind == 'text' else 0
            disabled: root.kind != 'text'
            on_text: root.changed()
        ListEditor:
            id: todo
            size_hint_y: 1 if root.kind == 'list' else 0
            opacity: 1 if root.kind == 'list' else 0
            disabled: root.kind != 'list'
        Clip:
            size_hint_y: None
            height: 0 if app.kb_open else dp(60)
            BoxLayout:
                size_hint_y: None
                height: dp(60)
                padding: dp(20), dp(8), dp(8), dp(8)
                canvas.before:
                    Color:
                        rgba: app.line_c
                    Rectangle:
                        pos: self.x, self.top - dp(1)
                        size: self.width, dp(1)
                BoxLayout:
                    id: dots
                    size_hint_x: None
                    width: self.minimum_width
                    spacing: dp(10)
                Widget:
                IconBtn:
                    icon: 'font'
                    on_release: root.cycle_font()

<LessonScreen>:
    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(8), 0
            IconBtn:
                icon: 'back'
                on_release: app.show_main()
            Label:
                text: root.heading
                bold: True
                font_size: '19sp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size
                padding: dp(6), 0
            IconBtn:
                icon: 'trash'
                tint: app.danger
                opacity: 1 if root.exists else 0
                disabled: not root.exists
                on_release: root.ask_delete()
        ScrollView:
            bar_width: 0
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20), dp(4), dp(20), dp(24)
                spacing: dp(4)
                Section:
                    text: 'Предмет'
                Field:
                    id: subject
                    hint: 'Например, алгебра'
                BoxLayout:
                    size_hint_y: None
                    height: dp(92)
                    spacing: dp(12)
                    padding: 0, dp(8), 0, 0
                    BoxLayout:
                        orientation: 'vertical'
                        Section:
                            text: 'Начало'
                        Field:
                            id: t_start
                            hint: '08:30'
                    BoxLayout:
                        orientation: 'vertical'
                        Section:
                            text: 'Конец'
                        Field:
                            id: t_end
                            hint: '09:15'
                Section:
                    text: 'Кабинет'
                Field:
                    id: room
                    hint: 'Например, 214'
                Section:
                    text: 'Преподаватель'
                Field:
                    id: teacher
                    hint: 'Необязательно'
                Section:
                    text: 'День недели'
                GridLayout:
                    id: days
                    cols: 6
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(6)
                Section:
                    text: 'Цвет'
                BoxLayout:
                    id: colors
                    size_hint_y: None
                    height: dp(46)
                    spacing: dp(10)
                Txt:
                    text: root.error
                    color: app.danger
                    font_size: '14sp'
        Pad:
            padding: dp(20), dp(8), dp(20), dp(16)
            PillBtn:
                text: 'Сохранить'
                on_release: root.save()
